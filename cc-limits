# backoff при 429: 60с, 120с, 240с ... но не дольше 15 минут
BACKOFF_BASE = 60.0
BACKOFF_MAX = 900.0
HISTORY_MAX = 2000  # строк, дальше обрезаем

# длины окон в секундах
WINDOW_5H = 5 * 3600
WINDOW_7D = 7 * 24 * 3600

C_RESET = "\033[0m"
C_DIM = "\033[2m"
C_BOLD = "\033[1m"
C_GREEN = "\033[32m"
C_YELLOW = "\033[33m"
C_RED = "\033[31m"
C_CYAN = "\033[36m"


_CONFIG = None


def config() -> dict:
    """Содержимое cc-limits.json. Нет файла - пустой конфиг."""
    global _CONFIG
    if _CONFIG is None:
        try:
            raw = json.loads(CONFIG_FILE.read_text())
        except FileNotFoundError:
            raw = {}
        except (OSError, json.JSONDecodeError) as e:
            raise RuntimeError(f"не разобрал {CONFIG_FILE}: {e}")
        if not isinstance(raw, dict):
            raise RuntimeError(f"{CONFIG_FILE}: ожидал объект, получил "
                               f"{type(raw).__name__}")
        _CONFIG = raw
    return _CONFIG


def load_reserves() -> dict:
    """
    Резерв - доля окна, которую нельзя тратить (например, аккаунт общий и
    напарник просил всегда оставлять 20% пятичасового окна). Вся математика
    считается от оставшегося бюджета: при резерве 20% расход 80% окна
    показывается как 100%, выше - больше 100%.

    Источники, последний побеждает:
      $CLAUDE_CONFIG_DIR/cc-limits.json -> {"reserve": {"five_hour": 20}}
      там же accounts[].reserve - резерв конкретного аккаунта
      переменные CC_LIMITS_RESERVE_5H / CC_LIMITS_RESERVE_7D
    По умолчанию резерва нет и показываются сырые проценты окна.
    """
    reserves = {"five_hour": 0.0, "seven_day": 0.0}

    raw = dict(config().get("reserve") or {})
    acc = active()
    if acc is not None:
        raw.update(acc.reserve_raw)

    for key in reserves:
        if key in raw:
            reserves[key] = parse_reserve(raw[key], f"{CONFIG_FILE}: reserve.{key}")

    for key, env in (("five_hour", "CC_LIMITS_RESERVE_5H"),
                     ("seven_day", "CC_LIMITS_RESERVE_7D")):
        if os.environ.get(env):
            reserves[key] = parse_reserve(os.environ[env], env)

    return reserves


def parse_reserve(value, where: str) -> float:
    """Резерв вне [0, 100) оставил бы нулевой или отрицательный бюджет."""
    try:
        num = float(value)
    except (TypeError, ValueError):
        raise RuntimeError(f"{where}: ожидал число, получил {value!r}")
    if not 0 <= num < 100:
        raise RuntimeError(f"{where}: резерв {num} вне диапазона 0..99")
    return num


_RESERVES = None


def reserves() -> dict:
    """Резервы окон активного аккаунта, считаются один раз на аккаунт."""
    global _RESERVES
    if _RESERVES is None:
        _RESERVES = load_reserves()
    return _RESERVES


def reserve_for(key: str) -> float:
    """Резерв окна. Недельные лимиты по моделям живут в недельном резерве."""
    r = reserves()
    return r["five_hour"] if key == "five_hour" else r["seven_day"]


def to_budget(pct: float, reserve: float):
    """Сырой процент окна -> процент доступного бюджета."""
    if pct is None:
        return None
    return pct / (100.0 - reserve) * 100.0


def color_enabled() -> bool:
    if os.environ.get("NO_COLOR"):
        return False
    return sys.stdout.isatty() or os.environ.get("CC_LIMITS_FORCE_COLOR") == "1"


def paint(text: str, color: str, on: bool) -> str:
    """Пустой color означает "не красить" - цвет берётся только у сигналов."""
    return f"{color}{text}{C_RESET}" if on and color else text


def dev_color(dev: float) -> str:
    """
    Отклонение от равномерного темпа: запас и ноль зелёным, перерасход жёлтым.
    Решение по округлённому значению, чтобы цвет не противоречил выведенной
    цифре (иначе +0.4% рисуется как "0%", но жёлтым).
    """
    return C_YELLOW if round(dev) > 0 else C_GREEN


def fmt_dev(dev: float) -> str:
    """
    Отклонение в процентах от равномерного темпа, со знаком.
    Выше +999% уже ничего не говорит - обрезаем.
    """
    if dev > 999:
        return ">+999%"
    r = round(dev)
    return "0%" if r == 0 else f"{r:+d}%"


def age_color(age: float) -> str:
    """
    Возраст данных. Решать, сколько ещё работать, по устаревшим цифрам лимита
    опаснее всего, поэтому после пяти минут жёлтый, после пятнадцати красный.
    """
    if age > 900:
        return C_RED
    if age > 300:
        return C_YELLOW
    return C_DIM


def risk_color(pct: float, dev, running_out: bool) -> str:
    """
    Цвет расхода по риску, а не по абсолютному уровню. Голый процент о риске
    ничего не говорит: 60% за десять минут до сброса - это запас. Красный,
    когда бюджет уже выбран или прогноз говорит, что упрёшься до сброса;
    жёлтый, когда жжёшь быстрее равномерного темпа; иначе зелёный.
    """
    if pct >= 100 or running_out:
        return C_RED
    if dev is not None and round(dev) > 0:
        return C_YELLOW
    return C_GREEN



# --- аккаунты ----------------------------------------------------------------

# Токены разных аккаунтов (личная подписка, общий токен парка машин) считают
# свои окна лимитов, поэтому у каждого аккаунта отдельные кэш, история и
# throttle: перемешанная история превратила бы скорость расхода и прогноз в
# бессмыслицу, а 429 по одному токену запирал бы запросы по другому.

ACCOUNT_SOURCES = ("auto", "keychain", "credentials", "env", "file",
                   "command", "token")


def slugify(name: str) -> str:
    """Имя аккаунта в часть имени файла. Кириллицу оставляем как есть."""
    slug = re.sub(r"[^\w.-]+", "-", name, flags=re.UNICODE).strip("-.")
    return slug.lower() or "acc"


class Account:
    """Откуда берётся токен аккаунта и где лежат его кэш, история, throttle."""

    def __init__(self, name: str, spec: dict, default: bool = False):
        self.name = name
        self.spec = spec
        self.source = spec.get("source") or "auto"
        self.default = default
        self.reserve_raw = dict(spec.get("reserve") or {})
        self.slug = slugify(name) if name else ""
        if default:
            # конфиг без accounts: имена файлов как были, чтобы накопленная
            # история не осиротела при обновлении
            self.cache_file = CACHE_FILE
            self.history_file = HISTORY_FILE
            self.throttle_file = THROTTLE_FILE
        else:
            self.cache_file = CACHE_DIR / f"cc-limits-cache-{self.slug}.json"
            self.history_file = CACHE_DIR / f"cc-limits-history-{self.slug}.jsonl"
            self.throttle_file = CACHE_DIR / f"cc-limits-throttle-{self.slug}"
        self._token = None

    @property
    def label(self) -> str:
        return self.name or "аккаунт по умолчанию"

    def token(self) -> dict:
        """{"accessToken": ..., "expiresAt": ...}. Читается один раз."""
        if self._token is None:
            self._token = self._read_token()
        return self._token

    def access_token(self) -> str:
        """Токен или пустая строка, если источник недоступен."""
        try:
            return self.token().get("accessToken") or ""
        except RuntimeError:
            return ""

    def _read_token(self) -> dict:
        src = self.source
        if src == "auto":
            return read_token_auto()
        if src == "keychain":
            return parse_credentials(read_keychain(), "Keychain")
        if src == "credentials":
            return parse_credentials(read_credentials_file(), str(CREDENTIALS_FILE))
        if src == "token":
            return self._raw(self.spec.get("token"), "accounts.token")
        if src == "env":
            var = self.spec.get("var") or "CLAUDE_CODE_OAUTH_TOKEN"
            return self._raw(os.environ.get(var), f"переменная {var}")
        if src == "file":
            path = self.spec.get("path")
            if not path:
                raise RuntimeError(f"аккаунт {self.label}: source=file без path")
            f = Path(os.path.expanduser(path))
            try:
                return self._raw(f.read_text(), str(f))
            except OSError as e:
                raise RuntimeError(f"аккаунт {self.label}: не прочитал {f}: {e}")
        if src == "command":
            cmd = self.spec.get("command")
            if not cmd:
                raise RuntimeError(f"аккаунт {self.label}: source=command без command")
            try:
                out = subprocess.run(
                    cmd, shell=isinstance(cmd, str), capture_output=True,
                    text=True, timeout=20, check=True,
                ).stdout
            except (subprocess.CalledProcessError, subprocess.TimeoutExpired,
                    OSError) as e:
                raise RuntimeError(f"аккаунт {self.label}: команда токена не "
                                   f"сработала: {e}")
            return self._raw(out, f"вывод команды аккаунта {self.label}")
        raise RuntimeError(f"аккаунт {self.label}: неизвестный source={src!r}")

    def _raw(self, value, where: str) -> dict:
        """
        Источник отдаёт либо голый токен, либо JSON сессии Claude Code
        (.credentials.json и вывод security find-generic-password). У голого
        токена срока нет: oat-токен от claude setup-token не рефрешится и
        expiresAt в нём не лежит.
        """
        text = (value or "").strip()
        if not text:
            raise RuntimeError(f"аккаунт {self.label}: пустой токен ({where})")
        if text.startswith("{"):
            return parse_credentials(text, where)
        return {"accessToken": text, "expiresAt": None}


_ACCOUNTS = None
_ACTIVE = None


def accounts() -> list:
    """Аккаунты из конфига. Без секции accounts - один аккаунт по умолчанию."""
    global _ACCOUNTS
    if _ACCOUNTS is None:
        _ACCOUNTS = load_accounts()
    return _ACCOUNTS


def load_accounts() -> list:
    raw = config().get("accounts")
    if raw is None:
        return [Account(None, {"source": "auto"}, default=True)]
    if not isinstance(raw, list) or not raw:
        raise RuntimeError(f"{CONFIG_FILE}: accounts должен быть непустым списком")

    out, seen_names, seen_slugs = [], set(), set()
    for i, spec in enumerate(raw):
        if not isinstance(spec, dict):
            raise RuntimeError(f"{CONFIG_FILE}: accounts[{i}] должен быть объектом")
        name = (spec.get("name") or "").strip()
        if not name:
            raise RuntimeError(f"{CONFIG_FILE}: accounts[{i}] без name")
        src = spec.get("source") or "auto"
        if src not in ACCOUNT_SOURCES:
            raise RuntimeError(f"{CONFIG_FILE}: accounts[{i}] ({name}): source="
                               f"{src!r}, ожидал один из "
                               f"{', '.join(ACCOUNT_SOURCES)}")
        acc = Account(name, spec)
        if name in seen_names:
            raise RuntimeError(f"{CONFIG_FILE}: аккаунт {name} описан дважды")
        if acc.slug in seen_slugs:
            raise RuntimeError(f"{CONFIG_FILE}: имена аккаунтов дают одинаковые "
                               f"имена файлов ({acc.slug}), переименуй")
        seen_names.add(name)
        seen_slugs.add(acc.slug)
        # резерв аккаунта проверяем здесь же, чтобы битый конфиг падал сразу
        for key, value in acc.reserve_raw.items():
            if key not in ("five_hour", "seven_day"):
                raise RuntimeError(f"{CONFIG_FILE}: accounts[{i}] ({name}): "
                                   f"reserve.{key} - нет такого окна")
            parse_reserve(value, f"{CONFIG_FILE}: accounts[{i}].reserve.{key}")
        out.append(acc)
    adopt_legacy_files(out)
    return out


def adopt_legacy_files(accs: list) -> None:
    """
    Кэш и история безымянного аккаунта достаются первому аккаунту, который
    читает тот же токен (keychain/credentials/auto). Иначе появление секции
    accounts обнуляло бы накопленные замеры: проценты вернулись бы со второго
    запроса, а прогноз ушёл бы в "мало замеров" на часы.

    Копируем, а не переносим: если конфиг откатят, прежние файлы на месте.
    Проверка "у наследника ещё нет своего файла" делает перенос однократным.
    """
    heir = next((a for a in accs
                 if a.source in ("auto", "keychain", "credentials")), None)
    if heir is None:
        return
    for src, dst in ((CACHE_FILE, heir.cache_file),
                     (HISTORY_FILE, heir.history_file)):
        try:
            if src.exists() and not dst.exists():
                dst.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(src, dst)
        except OSError:
            pass


def active() -> Account:
    """Аккаунт, с которым сейчас работаем."""
    global _ACTIVE
    if _ACTIVE is None:
        _ACTIVE = accounts()[0]
    return _ACTIVE


def use_account(acc: Account) -> None:
    """Переключает активный аккаунт: у него свои файлы и свой резерв."""
    global _ACTIVE, _RESERVES
    _ACTIVE = acc
    _RESERVES = None


def account_by_name(name: str) -> Account:
    for a in accounts():
        if a.name == name or (a.default and name in ("default", "по умолчанию")):
            return a
    known = ", ".join(a.label for a in accounts())
    raise RuntimeError(f"аккаунт {name!r} не описан в {CONFIG_FILE} (есть: {known})")


# --- какой аккаунт у текущего окна -------------------------------------------


def pid_ppid(pid: int):
    try:
        out = subprocess.run(["ps", "-o", "ppid=", "-p", str(pid)],
                             capture_output=True, text=True, timeout=5).stdout
        return int(out.strip())
    except (subprocess.TimeoutExpired, OSError, ValueError):
        return None


def pid_env_var(pid: int, var: str) -> str:
    """
    Значение переменной в окружении процесса.

    Linux отдаёт окружение через /proc, macOS - через ps eww. Важное
    ограничение (проверено 2026-10-17): ps показывает окружение на момент
    exec, поэтому у шелла переменных из .zshrc не видно, а у запущенного им
    процесса claude - видно. Нам нужен именно claude, так что годится.
    """
    try:
        with open(f"/proc/{pid}/environ", "rb") as f:
            for chunk in f.read().split(b"\0"):
                k, _, v = chunk.decode("utf-8", "replace").partition("=")
                if k == var:
                    return v
        return ""
    except OSError:
        pass
    try:
        out = subprocess.run(["ps", "eww", "-p", str(pid)],
                             capture_output=True, text=True, timeout=5).stdout
    except (subprocess.TimeoutExpired, OSError):
        return ""
    m = re.search(r"(?:^|\s)" + re.escape(var) + r"=(\S*)", out)
    return m.group(1) if m else ""


def session_token() -> str:
    """
    Токен, которым работает текущее окно Claude Code.

    Своё окружение годится только если переменная в нём есть: у statusline и
    хуков Claude Code её вырезает, поэтому дальше смотрим окружение самого
    процесса claude - сначала по $CLAUDE_PID, потом по цепочке родителей.
    Пустая строка означает "окно работает на сессии из Keychain".
    """
    own = os.environ.get("CLAUDE_CODE_OAUTH_TOKEN")
    if own:
        return own

    seen, pids = set(), []
    hint = os.environ.get("CLAUDE_PID")
    if hint and hint.isdigit():
        pids.append(int(hint))
    pid = os.getppid()
    for _ in range(12):
        if not pid or pid <= 1 or pid in seen:
            break
        seen.add(pid)
        pids.append(pid)
        pid = pid_ppid(pid)

    for p in pids:
        tok = pid_env_var(p, "CLAUDE_CODE_OAUTH_TOKEN")
        if tok:
            return tok
    return ""


# Во сколько обходится источник токена: статуслайн зовут каждый ход, и
# опрашивать менеджер секретов ради подписи аккаунта там нельзя. Сначала
# дешёвые источники, дорогие - в конце и только если дешёвые не совпали.
SOURCE_COST = {"token": 0, "env": 0, "file": 1, "credentials": 1,
               "keychain": 2, "auto": 2, "command": 3}
WINDOW_MAP_TTL = 3600  # сек, срок кэша соответствия отпечатка и аккаунта


def fingerprint(token: str) -> str:
    """Отпечаток токена: по нему сверяемся, не держа сам токен в файлах."""
    return hashlib.sha256(token.encode("utf-8")).hexdigest()[:16]


WINDOW_MAP_MAX = 16  # сколько отпечатков храним, дальше вытесняем старые


def read_window_map() -> dict:
    """
    Запомненные соответствия "отпечаток токена окна -> имя аккаунта".
    Записей несколько: на машине одновременно открыты окна на разных токенах,
    и единственная запись перезатиралась бы при каждом обновлении статуслайна.
    """
    try:
        d = json.loads(WINDOW_MAP_FILE.read_text())
    except (OSError, json.JSONDecodeError):
        return {}
    fps = d.get("fps") if isinstance(d, dict) else None
    if not isinstance(fps, dict):
        return {}
    now = time.time()
    return {fp: rec for fp, rec in fps.items()
            if isinstance(rec, dict) and now - (rec.get("t") or 0) <= WINDOW_MAP_TTL}


def window_map_lookup(fp: str) -> str:
    rec = read_window_map().get(fp) or {}
    return rec.get("account") or ""


def write_window_map(fp: str, name: str) -> None:
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    fps = read_window_map()
    fps[fp] = {"account": name, "t": time.time()}
    if len(fps) > WINDOW_MAP_MAX:
        oldest = sorted(fps.items(), key=lambda kv: kv[1].get("t") or 0)
        fps = dict(oldest[-WINDOW_MAP_MAX:])
    try:
        WINDOW_MAP_FILE.write_text(json.dumps({"fps": fps}))
    except OSError:
        pass


def session_account() -> tuple:
    """
    (аккаунт текущего окна, пояснение). Пояснение непустое, когда окно работает
    токеном, которого в конфиге нет: цифры тогда не про это окно, и молчать об
    этом нельзя.
    """
    accs = accounts()
    tok = session_token()
    if tok:
        fp = fingerprint(tok)
        remembered = window_map_lookup(fp)
        if remembered:
            for a in accs:
                if a.name == remembered:
                    return a, ""
        for a in sorted(accs, key=lambda x: SOURCE_COST.get(x.source, 3)):
            if a.access_token() == tok:
                write_window_map(fp, a.name)
                return a, ""
        return None, "токен этого окна в конфиге не описан"
    for a in accs:
        if a.source in ("auto", "keychain", "credentials"):
            return a, ""
    return None, "окно работает на сессии из Keychain, такого аккаунта в конфиге нет"


# --- получение данных --------------------------------------------------------


def read_keychain() -> str:
    """Содержимое записи Keychain (macOS). Пустая строка, если нет."""
    if sys.platform != "darwin":
        return ""
    try:
        return subprocess.run(
            ["security", "find-generic-password", "-a", os.environ.get("USER", ""),
             "-w", "-s", KEYCHAIN_SERVICE],
            capture_output=True, text=True, timeout=10, check=True,
        ).stdout
    except (subprocess.CalledProcessError, subprocess.TimeoutExpired, OSError):
        return ""


def read_credentials_file() -> str:
    """Содержимое ~/.claude/.credentials.json. Пустая строка, если нет."""
    try:
        return CREDENTIALS_FILE.read_text()
    except OSError:
        return ""


def parse_credentials(raw: str, source: str) -> dict:
    """Сессия Claude Code: {"claudeAiOauth": {...}} -> её содержимое."""
    if not (raw or "").strip():
        raise RuntimeError(f"токен не найден ({source}), "
                           f"выполни /login в Claude Code")
    try:
        return json.loads(raw)["claudeAiOauth"]
    except (json.JSONDecodeError, KeyError, TypeError) as e:
        raise RuntimeError(f"не разобрал токен из {source}: {e}")


def read_token_auto() -> dict:
    """
    OAuth-токен Claude Code. Источники в том же порядке, что у самого
    Claude Code: переменная окружения, Keychain (macOS), файл
    ~/.claude/.credentials.json (Linux и macOS без Keychain).
    """
    env_token = os.environ.get("CLAUDE_CODE_OAUTH_TOKEN")
    if env_token:
        return {"accessToken": env_token, "expiresAt": None}

    raw = read_keychain()
    if raw.strip():
        return parse_credentials(raw, "Keychain")
    raw = read_credentials_file()
    if raw.strip():
        return parse_credentials(raw, str(CREDENTIALS_FILE))
    raise RuntimeError(
        "токен не найден (ни Keychain, ни "
        f"{CREDENTIALS_FILE}), выполни /login в Claude Code"
    )


def read_token() -> dict:
    """Токен активного аккаунта."""
    return active().token()


def fetch_usage() -> dict:
    tok = read_token()
    expires_at = tok.get("expiresAt")
    if expires_at and expires_at / 1000 < time.time():
        raise RuntimeError("OAuth-токен истёк, запусти claude чтобы он обновился")
    req = urllib.request.Request(
        API_URL,
        headers={
            "Authorization": "Bearer " + tok["accessToken"],
            "anthropic-beta": OAUTH_BETA,
            "Content-Type": "application/json",
            "User-Agent": USER_AGENT,
        },
    )
    try:
        with urllib.request.urlopen(req, timeout=10) as resp:
            return json.load(resp)
    except urllib.error.HTTPError as e:
        body = e.read()[:200].decode("utf-8", "replace")
        if e.code == 401:
            if expires_at is None:
                # голый токен (claude setup-token) сам не рефрешится
                raise RuntimeError("401: токен отвергнут, нужен новый "
                                   "claude setup-token")
            raise RuntimeError("401: токен отвергнут, запусти claude для refresh")
        if e.code == 429:
            wait = note_rate_limit(e.headers.get("Retry-After"))
            raise RuntimeError(f"429: лимит запросов, пауза {fmt_dur(wait)}")
        raise RuntimeError(f"HTTP {e.code}: {body}")
    except urllib.error.URLError as e:
        raise RuntimeError(f"сеть недоступна: {e.reason}")


def read_throttle() -> dict:
    """{"until": момент, раньше которого не запрашиваем, "strikes": 429 подряд}"""
    empty = {"until": 0.0, "strikes": 0}
    try:
        d = json.loads(active().throttle_file.read_text())
    except (OSError, json.JSONDecodeError):
        return empty
    # до версии с backoff тут лежало голое число - валидный JSON, но не dict
    if not isinstance(d, dict):
        return empty
    try:
        return {"until": float(d.get("until") or 0),
                "strikes": int(d.get("strikes") or 0)}
    except (TypeError, ValueError):
        return empty


def write_throttle(until: float, strikes: int) -> None:
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    try:
        active().throttle_file.write_text(json.dumps({"until": until,
                                                      "strikes": strikes}))
    except OSError:
        pass


def note_rate_limit(retry_after) -> float:
    """
    Регистрирует 429 и возвращает, сколько ждать.

    Retry-After у этого эндпоинта ненадёжен: он присылает 0-1 секунду и
    продолжает отказывать. Поэтому ждём максимум из его подсказки и
    собственного backoff, который растёт с каждым 429 подряд. Иначе
    получается цикл "подождал секунду - снова 429".
    """
    strikes = read_throttle()["strikes"] + 1
    backoff = min(BACKOFF_BASE * 2 ** (strikes - 1), BACKOFF_MAX)
    hint = 0.0
    try:
        hint = float(retry_after or 0)
    except (TypeError, ValueError):
        pass
    wait = max(backoff, hint)
    write_throttle(time.time() + wait, strikes)
    return wait


def clear_rate_limit() -> None:
    """Успешный запрос обнуляет backoff."""
    if read_throttle()["strikes"]:
        write_throttle(0.0, 0)


def load_cache(max_age: float = CACHE_TTL):
    """Возвращает (data, age_sec) или (None, None) если кэша нет/устарел."""
    try:
        st = active().cache_file.stat()
    except OSError:
        return None, None
    age = time.time() - st.st_mtime
    if max_age is not None and age > max_age:
        return None, age
    try:
        return json.loads(active().cache_file.read_text()), age
    except (json.JSONDecodeError, OSError):
        return None, None


def save_cache(data: dict) -> None:
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    target = active().cache_file
    tmp = target.with_suffix(".tmp")
    tmp.write_text(json.dumps(data))
    tmp.replace(target)


def append_history(data: dict) -> None:
    """Пишет точку замера для расчёта скорости расхода."""
    row = {
        "t": time.time(),
        # сырые проценты: смена резерва не должна переписывать историю
        "h5": raw_pct_of(data, "five_hour"),
        "d7": raw_pct_of(data, "seven_day"),
        "h5_reset": reset_of(data, "five_hour"),
        "d7_reset": reset_of(data, "seven_day"),
    }
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    history = active().history_file
    with history.open("a") as f:
        f.write(json.dumps(row) + "\n")
    # обрезка, чтобы файл не рос бесконечно
    try:
        lines = history.read_text().splitlines()
        if len(lines) > HISTORY_MAX:
            history.write_text("\n".join(lines[-HISTORY_MAX:]) + "\n")
    except OSError:
        pass


def load_history() -> list:
    try:
        rows = []
        for line in active().history_file.read_text().splitlines():
            try:
                rows.append(json.loads(line))
            except json.JSONDecodeError:
                continue
        return rows
    except OSError:
        return []


def get_data(force: bool = False) -> tuple:
    """Возвращает (data, age, err). Берёт из кэша если свежий."""
    if not force:
        cached, age = load_cache()
        if cached is not None:
            return cached, age, None

    # сервер ранее ответил 429 - выдерживаем паузу, отдаём кэш
    wait_left = read_throttle()["until"] - time.time()
    if wait_left > 0:
        stale, age = load_cache(max_age=None)
        return stale, age, f"лимит запросов, повтор через {fmt_dur(wait_left)}"

    try:
        data = fetch_usage()
    except RuntimeError as e:
        stale, age = load_cache(max_age=None)
        return stale, age, str(e)
    clear_rate_limit()
    save_cache(data)
    append_history(data)
    return data, 0.0, None


# --- разбор ------------------------------------------------------------------


def raw_pct_of(data: dict, key: str):
    """Процент окна как его отдал сервер, без поправки на резерв."""
    node = (data or {}).get(key)
    if not node:
        return None
    return node.get("utilization")


def pct_of(data: dict, key: str):
    """Процент доступного бюджета: сырое значение с поправкой на резерв."""
    return to_budget(raw_pct_of(data, key), reserve_for(key))


def reset_of(data: dict, key: str):
    node = (data or {}).get(key)
    if not node or not node.get("resets_at"):
        return None
    return parse_iso(node["resets_at"])


def parse_iso(s: str) -> float:
    return datetime.fromisoformat(s).timestamp()


def fmt_dur(sec: float) -> str:
    if sec is None:
        return "?"
    sec = int(max(0, sec))
    d, rem = divmod(sec, 86400)
    h, rem = divmod(rem, 3600)
    m = rem // 60
    if d:
        return f"{d}д {h}ч {m:02d}м"
    if h:
        return f"{h}ч {m:02d}м"
    if m:
        return f"{m}м"
    return f"{sec}с"


def burn_rate(rows: list, field: str, reset_field: str, reset_ts: float,
              lookback: float, min_span: float, reserve: float = 0.0):
    """
    Скорость расхода в %/час по замерам внутри текущего окна.
    min_span - минимальный интервал между первым и последним замером, сек.
    Экстраполировать неделю по шести минутам наблюдений нельзя, поэтому
    пока разброс меньше min_span - честно отвечаем "данных мало".
    Возвращает (rate_per_hour, n_samples) или (None, n_samples)."""
    if reset_ts is None:
        return None, 0
    now = time.time()
    # только замеры текущего окна (тот же resets_at) и не старше lookback
    pts = [
        r for r in rows
        if r.get(field) is not None
        and r.get(reset_field) is not None
        and abs(r[reset_field] - reset_ts) < 120
        and now - r["t"] <= lookback
    ]
    if len(pts) < 2:
        return None, len(pts)
    pts.sort(key=lambda r: r["t"])
    span = pts[-1]["t"] - pts[0]["t"]
    if span < min_span:
        return None, len(pts)
    dt = span / 3600.0
    # история сырая, скорость приводим к бюджету тем же множителем
    dp = to_budget(pts[-1][field] - pts[0][field], reserve)
    return dp / dt, len(pts)


# Пока окно прошло меньше чем на MIN_ELAPSED_PCT, отклонение не считаем:
# в первые минуты окна знаменатель близок к нулю и отношение улетает в тысячи
# процентов, что ничего не говорит о реальном темпе.
MIN_ELAPSED_PCT = 2.0


def pace_dev(pct: float, reset_ts: float, window: float):
    """
    Отклонение расхода от равномерного бюджета окна, в процентах.
    0% - идёшь ровно по равномерному темпу.
    -60% - тратишь на 60% медленнее равномерного (запас).
    +60% - на 60% быстрее равномерного (к сбросу упрёшься).
    Возвращает (dev_pct, expected_pct) или (None, None).
    """
    if pct is None or reset_ts is None:
        return None, None
    window_start = reset_ts - window
    elapsed = time.time() - window_start
    if elapsed <= 0 or elapsed > window:
        return None, None
    expected = elapsed / window * 100
    if expected < MIN_ELAPSED_PCT:
        return None, expected
    return (pct / expected - 1) * 100, expected


# --- рендер ------------------------------------------------------------------


def bar(pct: float, width: int, on: bool, color: str = "") -> str:
    if pct is None:
        return paint("-" * width, C_DIM, on)
    filled = int(round(min(100.0, max(0.0, pct)) / 100 * width))
    return paint("#" * filled, color, on) + paint("." * (width - filled),
                                                  C_DIM, on)


def render_line(label: str, data: dict, key: str, window: float,
                rows: list, hist_field: str, hist_reset: str,
                lookback: float, min_span: float, width: int, on: bool) -> str:
    reserve = reserve_for(key)
    raw = raw_pct_of(data, key)
    pct = to_budget(raw, reserve)
    reset_ts = reset_of(data, key)
    if pct is None:
        return f" {label:<4} " + paint("нет данных", C_DIM, on)

    # отклонение и прогноз считаются раньше вывода: по ним красится процент
    dev, expected = pace_dev(pct, reset_ts, window)
    rate, n = burn_rate(rows, hist_field, hist_reset, reset_ts, lookback,
                        min_span, reserve)
    remain = reset_ts - time.time() if reset_ts else None
    eta = (100 - pct) / rate * 3600 if rate and rate > 0.05 else None
    running_out = eta is not None and remain is not None and eta < remain

    c = risk_color(pct, dev, running_out)
    parts = [
        f" {label:<4}",
        "[" + bar(pct, width, on, c) + "]",
        paint(f"{pct:5.1f}%", c + C_BOLD, on),
    ]
    # при резерве показываем и сырой процент окна, чтобы пересчёт был виден
    if reserve > 0:
        parts.append(paint(f"({raw:.0f}% окна)", C_DIM, on))

    if reset_ts is not None:
        parts.append(paint(f"сброс {fmt_dur(remain)}", C_DIM, on))

    if dev is not None:
        parts.append(paint(f"откл {fmt_dev(dev)}", dev_color(dev), on))
    elif expected is not None:
        parts.append(paint("откл: окно только началось", C_DIM, on))

    if rate is None:
        parts.append(paint(f"прогноз: мало замеров ({n})", C_DIM, on))
    elif eta is None:
        parts.append(paint("расход ~0", C_DIM, on))
    elif running_out:
        parts.append(paint(f"КОНЕЦ через {fmt_dur(eta)} ({rate:.1f}%/ч)",
                           C_RED + C_BOLD, on))
    else:
        parts.append(paint(f"хватит до сброса ({rate:.1f}%/ч)", C_GREEN, on))

    return "  ".join(parts)


def render(data: dict, age: float, err: str, width: int = 34,
           label: str = "", current: bool = False, header: bool = True) -> str:
    """
    Блок одного аккаунта. При header=False общая шапка не печатается, вместо
    неё идёт имя аккаунта: так блоки нескольких аккаунтов складываются в один
    вывод под общей шапкой.
    """
    on = color_enabled()
    rows = load_history()
    out = []

    agetxt = ""
    if age is not None and age > 5:
        agetxt = "  " + paint(f"(данным {fmt_dur(age)})", age_color(age), on)
    if header:
        stamp = datetime.now().strftime("%H:%M:%S")
        head = paint("Лимиты Claude Code", C_CYAN + C_BOLD, on)
        out.append(f"{head}  {paint(stamp, C_DIM, on)}{agetxt}")
    else:
        mark = paint("  (это окно)", C_DIM, on) if current else ""
        out.append(" " + paint(label, C_CYAN + C_BOLD, on) + mark + agetxt)
    note = reserve_note()
    if note:
        out.append(" " + paint(note, C_DIM, on))
    # пустая строка отделяет шапку от строк окон; в блоке аккаунта пробел между
    # блоками ставит вызывающий, иначе блок распухает
    if header:
        out.append("")

    if data is None:
        out.append(" " + paint(f"ошибка: {err}", C_RED, on))
        return "\n".join(out)

    # 5ч: смотрим назад 2 часа, минимум 10 минут замеров
    out.append(render_line("5ч", data, "five_hour", WINDOW_5H, rows,
                           "h5", "h5_reset", 2 * 3600, 10 * 60, width, on))
    # 7д: смотрим назад сутки, минимум 2 часа замеров
    out.append(render_line("7д", data, "seven_day", WINDOW_7D, rows,
                           "d7", "d7_reset", 24 * 3600, 2 * 3600, width, on))

    # недельные лимиты по моделям, если включены
    for key, label in (("seven_day_opus", "Opus"), ("seven_day_sonnet", "Sonnet")):
        if pct_of(data, key) is not None:
            out.append(render_line(label, data, key, WINDOW_7D, rows,
                                   "d7", "d7_reset", 24 * 3600, 2 * 3600,
                                   width, on))

    # scoped-лимиты на модель (например Fable 50% недельной квоты)
    for lim in data.get("limits") or []:
        scope = lim.get("scope") or {}
        model = (scope.get("model") or {}).get("display_name")
        if lim.get("kind") == "weekly_scoped" and model:
            p = to_budget(lim.get("percent"), reserves()["seven_day"])
            share = next((s for s in data.get("weekly_scoped_shares") or []
                          if s.get("limit_index") == (data["limits"].index(lim))), None)
            allow = share.get("allowance_percent_of_weekly") if share else None
            tail = f" (квота {allow}% недели)" if allow is not None else ""
            pc = risk_color(p or 0, None, False)
            out.append(f" {model:<4}  [" + bar(p, width, on, pc) + "]  "
                       + paint(f"{p:5.1f}%", pc, on) + paint(tail, C_DIM, on))

    # на что ушла неделя
    bd = data.get("seven_day_breakdown") or {}
    srows = [r for r in bd.get("rows") or [] if (r.get("percent") or 0) > 0]
    if srows:
        txt = ", ".join(f"{r['display_name']} {r['percent']}%" for r in srows)
        out.append("")
        out.append(" " + paint("неделя: " + txt, C_DIM, on))

    xu = data.get("extra_usage") or {}
    if xu.get("is_enabled"):
        out.append(" " + paint(
            f"extra usage: {xu.get('utilization')}% от ${xu.get('monthly_limit')}",
            C_DIM, on))

    if err:
        out.append("")
        out.append(" " + paint(f"обновить не удалось: {err}", C_YELLOW, on))

    return "\n".join(out)


def reserve_note() -> str:
    """Строка-пояснение: от какого бюджета считаются проценты."""
    parts = []
    for key, label in (("five_hour", "5ч"), ("seven_day", "7д")):
        r = reserves()[key]
        if r > 0:
            parts.append(f"{label}: 100% = {100 - r:.0f}% окна (резерв {r:.0f}%)")
    return "проценты от бюджета, " + ", ".join(parts) if parts else ""


def render_statusline(data: dict, err: str, age: float = None,
                      label: str = "", note: str = "") -> str:
    """
    label - имя аккаунта текущего окна, печатается последним через ту же
    вертикальную черту. note непустой, когда окно работает токеном, которого
    в конфиге нет: тогда цифры не про это окно, и об этом надо сказать прямо.
    """
    on = color_enabled()
    if data is None:
        return paint("лимиты: n/a", C_DIM, on)
    h5 = pct_of(data, "five_hour")
    d7 = pct_of(data, "seven_day")
    r5 = reset_of(data, "five_hour")
    r7 = reset_of(data, "seven_day")
    bits = []
    if h5 is not None:
        t = f" {fmt_dur(r5 - time.time())}" if r5 else ""
        dev, _ = pace_dev(h5, r5, WINDOW_5H)
        eq = ""
        if dev is not None:
            eq = " " + paint(fmt_dev(dev), dev_color(dev), on)
        mark = "*" if reserves()["five_hour"] > 0 else ""
        bits.append(paint(f"5ч{mark} {h5:.0f}%", risk_color(h5, dev, False), on)
                    + eq + paint(t, C_DIM, on))
    if d7 is not None:
        t = f" {fmt_dur(r7 - time.time())}" if r7 else ""
        dev, _ = pace_dev(d7, r7, WINDOW_7D)
        eq = ""
        if dev is not None:
            eq = " " + paint(fmt_dev(dev), dev_color(dev), on)
        mark = "*" if reserves()["seven_day"] > 0 else ""
        bits.append(paint(f"7д{mark} {d7:.0f}%", risk_color(d7, dev, False), on)
                    + eq + paint(t, C_DIM, on))

    # время последнего обновления: кэш живёт до двух минут, а при 429 и дольше,
    # и без отметки непонятно, насколько устаревшие цифры перед глазами
    if bits and age is not None:
        stamp = datetime.fromtimestamp(time.time() - age).strftime("%H:%M")
        bits.append(paint(stamp, age_color(age), on))

    if bits and note:
        bits.append(paint(f"аккаунт ? {note}", C_YELLOW, on))
    elif bits and label:
        bits.append(paint(label, C_DIM, on))

    return paint(" | ", C_DIM, on).join(bits) if bits else ""


# --- режимы ------------------------------------------------------------------


def spawn_background_refresh() -> None:
    """
    Асинхронно обновляет кэш, чтобы statusline не блокировался. Аккаунт
    передаём явно: процесс отвязан от сессии, окружение окна ему уже не видно.
    """
    cmd = [sys.executable, os.path.abspath(__file__), "--refresh"]
    acc = active()
    if not acc.default:
        cmd += ["--account", acc.name]
    try:
        subprocess.Popen(
            cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except OSError:
        pass


def use_window_account(forced: Account = None) -> tuple:
    """
    Делает активным аккаунт текущего окна и отдаёт (подпись, пояснение).

    При единственном аккаунте по умолчанию ничего не ищем: статуслайн
    вызывается каждый ход, лишние ps там не нужны, а подписывать нечего.
    """
    if forced is not None:
        use_account(forced)
        return forced.label, ""
    accs = accounts()
    if len(accs) == 1 and accs[0].default:
        return "", ""
    acc, note = session_account()
    if acc is None:
        # цифры покажем по первому аккаунту, но скажем, что окно работает не им
        use_account(accs[0])
        return accs[0].label, note
    use_account(acc)
    return acc.label, ""


def mode_statusline(forced: Account = None) -> int:
    label, note = use_window_account(forced)
    cached, age = load_cache()
    # Пока держится пауза после 429, обновлять нечего: фоновый процесс упёрся
    # бы в тот же throttle, а статуслайн зовут каждый ход.
    wait_left = read_throttle()["until"] - time.time()
    if cached is None:
        if wait_left <= 0:
            spawn_background_refresh()
        stale, stale_age = load_cache(max_age=None)
        if stale is None:
            # Без аккаунтов молчим, чтобы не мусорить в пустом статуслайне. А
            # вот когда аккаунт подписан, пропавший индикатор выглядит как
            # поломка: пишем, по какому аккаунту нет цифр и когда повтор.
            if label:
                txt = f"{label}: нет данных"
                if wait_left > 0:
                    txt += f", повтор через {fmt_dur(wait_left)}"
                print(paint(txt, C_DIM, color_enabled()), end="")
            return 0
        print(render_statusline(stale, None, stale_age, label, note), end="")
        return 0
    if age is not None and age > CACHE_TTL * 0.6 and wait_left <= 0:
        spawn_background_refresh()
    print(render_statusline(cached, None, age, label, note), end="")
    return 0


def render_accounts(force: bool, width: int = 34, only: list = None) -> tuple:
    """
    (текст, все ли аккаунты отдали цифры). Блок на аккаунт под общей шапкой;
    единственный аккаунт по умолчанию печатается как раньше, без подписей.
    """
    accs = only if only else accounts()
    show_labels = not (len(accs) == 1 and accs[0].default)
    current = None
    if show_labels:
        current, _ = session_account()

    out, ok = [], True
    if show_labels:
        on = color_enabled()
        stamp = datetime.now().strftime("%H:%M:%S")
        out.append(paint("Лимиты Claude Code", C_CYAN + C_BOLD, on)
                   + "  " + paint(stamp, C_DIM, on))
        out.append("")
    for acc in accs:
        use_account(acc)
        data, age, err = get_data(force=force)
        ok = ok and data is not None
        if show_labels:
            out.append(render(data, age, err, width, label=acc.label,
                              current=(current is acc), header=False))
            out.append("")
        else:
            out.append(render(data, age, err, width))
    return "\n".join(out).rstrip("\n"), ok


def mode_watch(interval: float, only: list = None) -> int:
    sys.stdout.write("\033[?1049h\033[?25l")  # alt-screen, курсор прячем
    sys.stdout.flush()
    try:
        while True:
            frame, _ = render_accounts(force=True, only=only)
            sys.stdout.write("\033[H\033[2J" + frame + "\n\n")
            sys.stdout.write(f"\033[2mобновление каждые {int(interval)} сек, "
                             f"Ctrl-C для выхода\033[0m\n")
            sys.stdout.flush()
            time.sleep(interval)
    except KeyboardInterrupt:
        return 0
    finally:
        sys.stdout.write("\033[?25h\033[?1049l")
        sys.stdout.flush()


def main() -> int:
    args = sys.argv[1:]

    if "--help" in args or "-h" in args:
        print(__doc__)
        return 0

    # конфиг читаем до всего остального: если он битый, молча считать от
    # неправильного бюджета или не того аккаунта нельзя
    try:
        forced = None
        if "--account" in args:
            idx = args.index("--account")
            if len(args) <= idx + 1:
                raise RuntimeError("--account без имени аккаунта")
            forced = account_by_name(args[idx + 1])
        selected = [forced] if forced else accounts()
        use_account(selected[0])
        reserves()
    except RuntimeError as e:
        if "--statusline" in args:
            # в статуслайн трейсбек не лезет, но и пропадать молча индикатор
            # не должен
            print(paint("лимиты: битый конфиг", C_RED, color_enabled()), end="")
            return 1
        print(f"ошибка конфигурации: {e}", file=sys.stderr)
        return 1

    if "--accounts" in args:
        cur, note = session_account()
        for acc in accounts():
            mark = "  <- это окно" if acc is cur else ""
            print(f"{acc.label}  source={acc.source}{mark}")
        if note:
            print(f"окно: {note}", file=sys.stderr)
        return 0

    if "--refresh" in args:
        rc = 0
        for acc in selected:
            use_account(acc)
            _, _, err = get_data(force=True)
            if err:
                prefix = "" if acc.default else f"{acc.label}: "
                print(prefix + err, file=sys.stderr)
                rc = 1
        return rc

    if "--json" in args:
        force = "--cache" not in args
        if "--all" in args:
            out, rc = {}, 0
            for acc in accounts():
                use_account(acc)
                data, _, err = get_data(force=force)
                out[acc.label] = data if data is not None else {"error": err}
                if data is None:
                    rc = 1
            print(json.dumps(out, indent=2, ensure_ascii=False))
            return rc
        # один аккаунт - форма ответа как была, чтобы не ломать скрипты
        if forced is None:
            use_window_account()
        data, _, err = get_data(force=force)
        if data is None:
            print(json.dumps({"error": err}), file=sys.stderr)
            return 1
        print(json.dumps(data, indent=2, ensure_ascii=False))
        return 0

    if "--statusline" in args:
        return mode_statusline(forced)

    if "--watch" in args or "-w" in args:
        flag = "--watch" if "--watch" in args else "-w"
        idx = args.index(flag)
        interval = 120.0
        if len(args) > idx + 1:
            try:
                interval = max(MIN_WATCH_INTERVAL, float(args[idx + 1]))
            except ValueError:
                pass
        return mode_watch(interval, only=selected)

    # по умолчанию кэш (TTL 120 сек), чтобы частые запуски не ели квоту
    # эндпоинта; --force игнорирует кэш
    out, ok = render_accounts(force="--force" in args, only=selected)
    print(out)
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())
