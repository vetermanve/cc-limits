#!/usr/bin/env python3
"""
cc-limits - индикатор лимитов Claude Code (5-часовой и недельный).

Данные берутся из того же эндпоинта, что использует сам Claude Code:
  GET https://api.anthropic.com/api/oauth/usage
OAuth-токен берётся оттуда же, откуда его берёт Claude Code:
$CLAUDE_CODE_OAUTH_TOKEN, macOS Keychain (service "Claude Code-credentials")
или ~/.claude/.credentials.json.

Несколько аккаунтов (личная подписка и, скажем, общий токен парка машин)
описываются в $CLAUDE_CONFIG_DIR/cc-limits.json:

  {"accounts": [
     {"name": "личный", "source": "keychain"},
     {"name": "флот",   "source": "command",
      "command": "security find-generic-password -s fleet-token -w",
      "reserve": {"five_hour": 50}}
  ]}

source: auto (как Claude Code: переменная, Keychain, файл), keychain,
credentials, env (+ "var"), file (+ "path"), command (+ "command"),
token (+ "token"). У каждого аккаунта свои кэш, история и throttle.

В statusline последним через ту же вертикальную черту печатается имя
аккаунта, которым работает ЭТО окно: токен окна берётся из окружения процесса
claude (переменную Claude Code не передаёт потомкам). Соответствие токена и
аккаунта кэшируется по отпечатку (cache/cc-limits-window.json), чтобы дорогие
источники вроде менеджера секретов не опрашивались каждый ход. Если токен окна
в конфиге не описан, вместо имени выводится предупреждение - цифры тогда не
про это окно.

Если аккаунт общий и часть окна надо держать в резерве, резерв задаётся в
cc-limits.json ({"reserve": {"five_hour": 20}}), для отдельного аккаунта -
в accounts[].reserve, либо переменными CC_LIMITS_RESERVE_5H /
CC_LIMITS_RESERVE_7D. Тогда все проценты, отклонение и прогноз считаются от
оставшегося бюджета: при резерве 20% расход 80% окна показывается как 100%.

Режимы:
  cc-limits                 одноразовый вывод (из кэша, если свежий)
  cc-limits --force         игнорировать кэш, запросить сервер
  cc-limits --watch [сек]   живой индикатор (по умолчанию 120 сек, минимум 60)
  cc-limits --statusline    компакт в одну строку (для statusLine Claude Code)
  cc-limits --json          сырой ответ API по аккаунту этого окна
  cc-limits --json --all    сырые ответы по всем аккаунтам
  cc-limits --accounts      какие аккаунты описаны и какой у этого окна
  cc-limits --account ИМЯ   работать только с этим аккаунтом
  cc-limits --refresh       только обновить кэш и выйти (для фона)

Кэш: $CLAUDE_CONFIG_DIR/cache/cc-limits-cache.json (TTL 120 сек), у
именованных аккаунтов - cc-limits-cache-ИМЯ.json
История: там же, cc-limits-history.jsonl (для расчёта скорости расхода)
"""

import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.request
from datetime import datetime, timezone
from pathlib import Path

API_URL = "https://api.anthropic.com/api/oauth/usage"
KEYCHAIN_SERVICE = "Claude Code-credentials"
OAUTH_BETA = "oauth-2025-04-20"
USER_AGENT = "claude-cli/2.1.273 (external, cli)"

# Claude Code держит конфиг в $CLAUDE_CONFIG_DIR, иначе в ~/.claude
CONFIG_DIR = Path(os.environ.get("CLAUDE_CONFIG_DIR") or (Path.home() / ".claude"))
CREDENTIALS_FILE = CONFIG_DIR / ".credentials.json"
CONFIG_FILE = CONFIG_DIR / "cc-limits.json"
CACHE_DIR = CONFIG_DIR / "cache"
# Файлы аккаунта по умолчанию (конфиг без accounts). У именованных аккаунтов
# к имени добавляется слаг, см. Account.
CACHE_FILE = CACHE_DIR / "cc-limits-cache.json"
HISTORY_FILE = CACHE_DIR / "cc-limits-history.jsonl"
# соответствие "отпечаток токена окна -> аккаунт", чтобы не опрашивать
# источники токенов на каждый вызов статуслайна
WINDOW_MAP_FILE = CACHE_DIR / "cc-limits-window.json"
CACHE_TTL = 120  # сек
# Эндпоинт /api/oauth/usage имеет скользящее окно лимита (~5 мин) и на 429
# присылает Retry-After. Мы его чтим: THROTTLE_FILE хранит момент, раньше
# которого запрос не делаем.
MIN_WATCH_INTERVAL = 60.0
